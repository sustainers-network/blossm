  },
  "devDependencies": {
    "@blossm/array-difference": "^0.0.11",
    "@blossm/channel-name": "^0.0.10",
    "@blossm/command-post": ">=0.0.312",
    "@blossm/crypt": "^0.0.10",
    "@blossm/duration-consts": "^0.0.7",
    "@blossm/gcp-token": "^0.0.89",
    "@blossm/phone-number": "^0.0.10",
    "@blossm/random-int-of-length": "^0.0.12",
    "@blossm/random-string-of-length": "^0.0.8",
    "@blossm/twilio-sms": "^0.0.10",
    "@blossm/validator": "^0.0.60",
    "chai": "^5.2.0",
    "chai-datetime": "^1.8.1",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.1",
    "faas-grip": "^2.0.0",
    "grip": "^1.6.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.1.3",
    "mocha": "^11.6.0",
    "nodemailer": "7.0.4",
    "prettier": "^2.0.4",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@blossm/cli": "0.0.1965",
    "global": "^4.4.0"
  }

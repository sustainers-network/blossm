{
  "name": "dianet.work",
  "description": "The Dia blossm codebase",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mejango/dia.git"
  },
  "author": "dianet.work",
  "bugs": {
